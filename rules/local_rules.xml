<!-- Custom ransomware-detection rules (Member 1). IDs 100100-100105. -->
<group name="local,syscheck,ransomware,">

  <!-- Base: every FIM event, so frequency rules can count them -->
  <rule id="100100" level="3">
    <if_group>syscheck</if_group>
    <description>File integrity event tracked for ransomware correlation.</description>
    <group>ransomware_watch,</group>
  </rule>

  <!-- 15+ file events from one agent within 20s -->
  <rule id="100101" level="12" frequency="15" timeframe="20">
    <if_matched_group>syscheck</if_matched_group>
    <same_location />
    <description>Possible ransomware: mass file modification (15+ file events in 20s).</description>
    <mitre><id>T1486</id></mitre>
    <group>ransomware_detected,mass_file_change,</group>
  </rule>

  <!-- Ransomware-style extension -->
  <rule id="100102" level="14">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\.(locked|encrypted|crypt|enc|ransom|wcry|wncry|locky|cerber|zzz|micro)$</field>
    <description>Ransomware-pattern file extension detected: $(file)</description>
    <mitre><id>T1486</id></mitre>
    <group>ransomware_detected,suspicious_extension,</group>
  </rule>

  <!-- Ransom-note-style filename -->
  <rule id="100103" level="14">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)(readme|decrypt|how_to|restore_files|ransom).*\.(txt|html|hta)$</field>
    <description>Possible ransom note file created: $(file)</description>
    <mitre><id>T1486</id></mitre>
    <group>ransomware_detected,ransom_note,</group>
  </rule>

  <!-- Highest confidence: 10+ ransomware-extension files within 30s from one agent -->
  <rule id="100104" level="15" frequency="10" timeframe="30">
    <if_matched_sid>100102</if_matched_sid>
    <same_location />
    <description>HIGH CONFIDENCE: ransomware behavior confirmed (10+ ransomware-extension files in 30s).</description>
    <mitre><id>T1486</id></mitre>
    <group>ransomware_confirmed,critical,</group>
  </rule>

  <!-- Windows: shadow copy / backup deletion (needs Sysmon or command logging) -->
  <rule id="100105" level="15">
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(vssadmin\s+delete\s+shadows|wbadmin\s+delete\s+catalog|bcdedit.*recoveryenabled\s+no)</field>
    <description>Backup/shadow-copy deletion command detected - strong ransomware indicator.</description>
    <mitre><id>T1490</id></mitre>
    <group>ransomware_detected,backup_deletion,</group>
  </rule>

</group>
